# 无配置可查看页面壳和 preview；M1 认证/保存需以下公开配置。不要提交 .env.local。
# 公开 key 必须是 publishable/anon，绝不能填管理员 key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 本地例如 http://localhost:3000；部署填写实际 HTTPS origin，配合 Auth Redirect URLs。
APP_URL=http://localhost:3000
# M1 不使用；后续如需要，仅服务端，绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=
# 以下 LLM 配置在 M2 接入，M1 不调用模型。
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_REQUEST_LIMIT=30
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=1200
# 可选价格由服务商当前报价维护，不预设费用
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=
# 只允许指向已迁移的隔离测试数据库，禁止生产连接。
# test:rls 需显式开启；普通 npm test 使用临时本地 PostgreSQL。
M1_ALLOW_DATABASE_TESTS=
M1_TEST_DATABASE_URL=
